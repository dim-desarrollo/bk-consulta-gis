/*
    Jenkinsfile.build
    ------------------------------------------------------
    Comportamiento:
    - Construye la imagen Docker
    - Siempre etiqueta como :latest (sobrescribe si existe)
*/

def RAMA_PARA_CLONAR

pipeline {

    agent any

    tools {
        dotnetsdk 'net8'
    }

    environment {
        IDENTIFICADOR_IMAGEN = 'bk-tableros'
        CARPETA_APLICACION   = './'
        HORA_DESPLIEGUE      = ""
    }

    stages {

        stage('Inicializar variables') {
            steps {
                script {
                    env.HORA_DESPLIEGUE = sh(
                        returnStdout: true,
                        script: "date '+%A %W %Y %X'"
                    ).trim()

                    if (env.BRANCH_NAME) {
                        RAMA_PARA_CLONAR = env.BRANCH_NAME
                    } else {
                        RAMA_PARA_CLONAR = 'develop'
                    }

                    echo "Branch detectado: ${RAMA_PARA_CLONAR}"
                    echo "Hora de inicio: ${env.HORA_DESPLIEGUE}"
                }
            }
        }

        stage('Verificación de herramientas') {
            steps {
                script {
                    def DOCKER_VERSION = sh(returnStdout: true, script: 'docker version').trim()
                    echo "Docker version: ${DOCKER_VERSION}"
                }
            }
        }

        stage('Build de imagen Docker') {
            steps {
                script {
                    dir("${CARPETA_APLICACION}") {

                        // Verificar que existe Dockerfile
                        if (!fileExists("Dockerfile")) {
                            error "ERROR: No se encontró un Dockerfile en el directorio del proyecto."
                        }

                        // Construir imagen directamente con tag :latest
                        echo "Construyendo imagen: ${IDENTIFICADOR_IMAGEN}:latest"
                        sh "docker build -t ${IDENTIFICADOR_IMAGEN}:latest ."

                        // Obtener ID de la imagen construida
                        def imageId = sh(
                            script: "docker images -q ${IDENTIFICADOR_IMAGEN}:latest",
                            returnStdout: true
                        ).trim()

                        echo "Imagen construida exitosamente - ID: ${imageId}"
                    }
                }
            }
        }

        stage('Fin del proceso') {
            steps {
                echo "Build finalizado exitosamente."
                echo "Imagen disponible: ${IDENTIFICADOR_IMAGEN}:latest"
            }
        }
    }
}
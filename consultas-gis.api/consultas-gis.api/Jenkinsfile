pipeline {
    agent any

    environment {
        CARPETA_APLICACION = './consultas-gis.api/consultas-gis.api'
        ASPNETCORE_ENVIRONMENT = 'Development'
        CONTENEDOR = 'deploy-rapido'
        IMAGEN = 'consultas-gisapi-app-net-api'
    }

    stages {
        stage('Leer y calcular versi�n') {
            steps {
                dir("${CARPETA_APLICACION}") {
                    script {
                        if (!fileExists('VERSION')) {
                            echo "Archivo VERSION no existe. Creando con versi�n inicial v1.0"
                            writeFile file: 'VERSION', text: 'v1.0\n'
                        }

                        def versionFile = readFile('VERSION').trim()
                        def versionParts = versionFile.replace('v', '').tokenize('.')
                        def major = versionParts[0].toInteger()
                        def minor = versionParts[1].toInteger() + 1

                        env.NEW_VERSION = "v${major}.${minor}"

                        writeFile file: 'VERSION', text: "${env.NEW_VERSION}\n"
                        echo "Nueva versi�n generada: ${env.NEW_VERSION}"
                    }
                }
            }
        }

        stage('Retag imagen actual antes de build') {
            steps {
                sh '''
                    if docker images ${IMAGEN}:latest | grep -q ${IMAGEN}; then
                        echo "Retaggeando imagen 'latest' como '${IMAGEN}:${NEW_VERSION}'"
                        docker tag ${IMAGEN}:latest ${IMAGEN}:${NEW_VERSION}
                        docker ps
                    else
                        echo "No hay imagen ${IMAGEN}:latest para retaggear"
                    fi
                '''
            }
        }

        stage('Eliminar contenedor anterior') {
            steps {
                sh '''
                    if [ "$(docker ps -aq -f name=${CONTENEDOR})" ]; then
                        echo "Eliminando contenedor existente: ${CONTENEDOR}"
                        docker stop ${CONTENEDOR} || true
                        docker rm ${CONTENEDOR} || true
                    else
                        echo "No existe un contenedor con el nombre ${CONTENEDOR}"
                    fi
                '''
            }
        }

        stage('Reconstruir y desplegar') {
            steps {
                dir("${CARPETA_APLICACION}") {
                    sh '''
                        docker -v
                        echo "Construyendo imagen..."
                        docker-compose build

                        echo "Desplegando contenedor..."
                        docker-compose up -d
                    '''
                }
            }
        }

        stage('Resumen') {
            steps {
                echo "Despliegue exitoso"
                echo "Imagen etiquetada como: ${IMAGEN}:latest"
                echo "Imagen anterior guardada como: ${IMAGEN}:${NEW_VERSION}"
            }
        }
    }
}
